---
import { LEGAL_LINKS, NAV_LINKS } from "@/consts";
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div>
        <p class="eyebrow">Harder Labs / Austin, Texas</p>
        <h2>
          Good ideas deserve
          <br />
          <em>real execution.</em>
        </h2>
      </div>
      <a href="mailto:kevin@harder.dev" class="footer-contact">
        Start a conversation <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} Harder Labs LLC</p>
      <nav aria-label="Footer navigation">
        {NAV_LINKS.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
        {LEGAL_LINKS.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
      <p>Built with curiosity. Operated with care.</p>
    </div>
  </div>
</footer>
<style>
  .site-footer {
    padding: clamp(4rem, 7vw, 7rem) 0 1.5rem;
    border-top: 1px solid var(--border);
    background: #0b110e;
  }
  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    padding-bottom: clamp(4rem, 7vw, 7rem);
  }
  .footer-top h2 {
    margin-top: 1.6rem;
    font-size: clamp(2.5rem, 5vw, 6rem);
  }
  .footer-top em {
    color: var(--accent-primary);
    font-style: normal;
  }
  .footer-contact {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    min-width: 250px;
    border-bottom: 1px solid var(--accent-primary);
    padding-bottom: 0.8rem;
    color: var(--accent-primary);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    border-top: 1px solid var(--border);
    padding-top: 1.4rem;
  }
  .footer-bottom p,
  .footer-bottom a {
    font-size: 0.73rem;
    color: var(--text-muted);
  }
  .footer-bottom nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer-bottom a:hover {
    color: var(--accent-primary);
  }
  @media (max-width: 700px) {
    .footer-top {
      display: block;
    }
    .footer-contact {
      margin-top: 2.5rem;
      max-width: 300px;
    }
    .footer-bottom {
      display: grid;
    }
  }
</style>
