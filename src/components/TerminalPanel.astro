---
type Props = { title?: string; subtitle?: string; className?: string };
const { title = "field_notes", subtitle, className = "" } = Astro.props as Props;
---

<section class={`terminal ${className}`.trim()}>
  <header class="terminal-head">
    <span class="terminal-dot" aria-hidden="true"></span>
    <p>{title}</p>
    <span>HL / 01</span>
  </header>
  {subtitle && <p class="terminal-subtitle">{subtitle}</p>}
  <div class="terminal-body">
    <slot />
  </div>
</section>
<style>
  .terminal {
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface-0);
    overflow: hidden;
  }
  .terminal-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.9rem 1.3rem;
    border-bottom: 1px solid var(--border);
  }
  .terminal-head p,
  .terminal-head > span:last-child {
    color: var(--accent-primary);
    font:
      500 0.68rem var(--font-ibm-plex-mono),
      monospace;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .terminal-head > span:last-child {
    margin-left: auto;
    color: var(--text-muted);
  }
  .terminal-dot {
    width: 7px;
    height: 7px;
    background: var(--accent-primary);
    border-radius: 50%;
    box-shadow: 0 0 12px var(--accent-primary);
  }
  .terminal-subtitle {
    padding: 1rem 1.3rem 0;
    color: var(--text-muted);
  }
  .terminal-body {
    padding: clamp(1.3rem, 2.5vw, 2rem);
    display: grid;
    gap: 1rem;
  }
  .terminal-body :global(strong) {
    font-weight: 500;
  }
  .terminal-body :global(ul) {
    margin: 0;
    padding-left: 1.2rem;
  }
  .terminal-body :global(li) {
    margin: 0.35rem 0;
  }
</style>
