---
type Props = { value: string; href?: string; tone?: "neutral" | "primary" | "warning" };
const { value, href, tone = "neutral" } = Astro.props as Props;
---

{href ? (
  <a href={href} class={`chip ${tone}`}>
    {value}
  </a>
) : (
  <span class={`chip ${tone}`}>{value}</span>
)}
<style>
  .chip {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border);
    padding: 0.28rem 0.55rem;
    color: var(--text-soft);
    font:
      500 0.68rem var(--font-ibm-plex-mono),
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .chip.primary {
    color: var(--bg-0);
    background: var(--accent-primary);
    border-color: var(--accent-primary);
  }
  .chip.warning {
    color: var(--accent-tertiary);
    border-color: var(--accent-tertiary);
  }
  a.chip:hover {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
  }
</style>
