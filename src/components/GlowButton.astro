---
type Props = {
  href?: string;
  target?: "_blank" | "_self";
  variant?: "primary" | "ghost";
  className?: string;
};
const { href, target = "_self", variant = "primary", className = "" } = Astro.props as Props;
const rel = target === "_blank" ? "noreferrer noopener" : undefined;
---

{href ? (
  <a href={href} target={target} rel={rel} class={`glow-btn ${variant} ${className}`.trim()}>
    <slot />
    <span aria-hidden="true">↗</span>
  </a>
) : (
  <button type="button" class={`glow-btn ${variant} ${className}`.trim()}>
    <slot />
    <span aria-hidden="true">↗</span>
  </button>
)}
<style>
  .glow-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 48px;
    padding: 0.72rem 1.05rem;
    border: 1px solid var(--accent-primary);
    border-radius: 2px;
    font:
      600 0.85rem var(--font-dm-sans),
      sans-serif;
    transition:
      background 0.18s,
      color 0.18s,
      transform 0.18s;
  }
  .glow-btn.primary {
    color: var(--bg-0);
    background: var(--accent-primary);
  }
  .glow-btn.ghost {
    color: var(--accent-primary);
    background: transparent;
  }
  .glow-btn:hover {
    transform: translateY(-2px);
  }
  .glow-btn.primary:hover {
    background: var(--text-main);
    border-color: var(--text-main);
    color: var(--bg-0);
  }
  .glow-btn.ghost:hover {
    background: var(--accent-primary);
    color: var(--bg-0);
  }
</style>
