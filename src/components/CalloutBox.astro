---
type Props = { tone?: "info" | "warning" | "success"; title?: string };
const { tone = "info", title } = Astro.props as Props;
---

<aside class={`callout ${tone}`}>
  {title && <h3>{title}</h3>}
  <div class="callout-body">
    <slot />
  </div>
</aside>
<style>
  .callout {
    border-left: 2px solid var(--accent-secondary);
    padding: 1rem 1.3rem;
    background: var(--surface-1);
    display: grid;
    gap: 0.5rem;
  }
  .callout h3 {
    font:
      500 0.76rem var(--font-ibm-plex-mono),
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-secondary);
  }
  .callout.warning {
    border-color: var(--accent-tertiary);
  }
  .callout.warning h3 {
    color: var(--accent-tertiary);
  }
  .callout.success {
    border-color: var(--accent-primary);
  }
  .callout.success h3 {
    color: var(--accent-primary);
  }
</style>
