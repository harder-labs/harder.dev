---
type Props = { as?: "article" | "section" | "div"; className?: string };
const { as = "article", className = "" } = Astro.props as Props;
const Component = as;
---

<Component class={`neon-card ${className}`.trim()}>
  <slot />
</Component>
<style>
  .neon-card {
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface-0);
    padding: clamp(1.5rem, 2.5vw, 2.4rem);
    transition:
      border-color 0.2s,
      background 0.2s,
      transform 0.2s;
  }
  .neon-card:hover {
    border-color: var(--accent-primary);
    background: var(--surface-1);
    transform: translateY(-3px);
  }
  .neon-card :global(h2),
  .neon-card :global(h3) {
    letter-spacing: -0.035em;
  }
  .neon-card :global(p) {
    line-height: 1.65;
  }
</style>
