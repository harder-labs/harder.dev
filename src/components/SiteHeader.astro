---
import { NAV_LINKS } from "@/consts";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="container header-row">
    <a href="/" class="brand" aria-label="Harder Labs home">
      <span class="brand-mark" aria-hidden="true">
        H<span></span>
      </span>
      <span class="brand-name">
        HARDER<span>LABS</span>
      </span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {NAV_LINKS.map((item) => (
        <a href={item.href} aria-current={path === item.href ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
    <a class="header-cta" href="/contact">
      Let's talk <span aria-hidden="true">↗</span>
    </a>
    <details class="mobile-nav">
      <summary aria-label="Open navigation">
        <span></span>
        <span></span>
        <span class="sr-only">Menu</span>
      </summary>
      <nav aria-label="Mobile navigation">
        {NAV_LINKS.map((item) => (
          <a href={item.href} aria-current={path === item.href ? "page" : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    background: rgba(17, 23, 21, 0.94);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--border);
  }
  .header-row {
    min-height: 80px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-right: auto;
  }
  .brand-mark {
    position: relative;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--accent-primary);
    color: var(--accent-primary);
    font:
      600 1.6rem var(--font-sora),
      sans-serif;
    line-height: 1;
  }
  .brand-mark > span {
    position: absolute;
    width: 5px;
    height: 5px;
    right: -3px;
    top: -3px;
    background: var(--accent-primary);
  }
  .brand-name {
    display: flex;
    flex-direction: column;
    color: var(--text-main);
    font:
      700 0.98rem/1 var(--font-sora),
      sans-serif;
    letter-spacing: -0.06em;
  }
  .brand-name span {
    font:
      500 0.61rem/1.5 var(--font-ibm-plex-mono),
      monospace;
    letter-spacing: 0.42em;
    color: var(--accent-primary);
  }
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .desktop-nav a {
    color: var(--text-soft);
    font-size: 0.88rem;
  }
  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] {
    color: var(--accent-primary);
  }
  .header-cta {
    border: 1px solid var(--accent-primary);
    padding: 0.65rem 1rem;
    color: var(--accent-primary);
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .header-cta:hover {
    background: var(--accent-primary);
    color: var(--bg-0);
  }
  .header-cta span {
    margin-left: 0.9rem;
  }
  .mobile-nav {
    display: none;
  }
  .mobile-nav summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    gap: 5px;
    padding: 0.7rem;
  }
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  .mobile-nav summary > span:not(.sr-only) {
    width: 22px;
    height: 2px;
    background: var(--accent-primary);
  }
  .mobile-nav nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    display: grid;
    padding: 1rem;
    background: var(--bg-0);
    border-bottom: 1px solid var(--border);
  }
  .mobile-nav nav a {
    padding: 0.8rem;
    border-bottom: 1px solid var(--border);
  }
  .mobile-nav nav a[aria-current="page"] {
    color: var(--accent-primary);
  }
  @media (max-width: 900px) {
    .desktop-nav,
    .header-cta {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
    .header-row {
      min-height: 70px;
    }
  }
</style>
