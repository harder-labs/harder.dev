---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GlowButton from "@/components/GlowButton.astro";
---

<BaseLayout
  title="About Harder Labs | Austin Venture Lab"
  description="Meet Harder Labs, an Austin venture lab founded by Kevin Harder to build e-commerce brands, communities, and software products."
>
  <section class="page-hero">
    <div class="container">
      <p class="muted">02 / About the lab</p>
      <h1 class="hero-title">
        Small team.
        <br />
        Wide curiosity.
      </h1>
      <p class="hero-subtitle">
        Harder Labs is an engineering-led venture lab based in Austin, Texas. We build and operate
        e-commerce brands, online communities, and software products.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container about-intro">
      <p class="eyebrow">A note from the lab</p>
      <div>
        <h2 class="section-title">Ideas are the beginning. The work is what matters.</h2>
        <p>
          We believe the best businesses start with a curious question. Harder Labs gives those
          questions a place to become working products. Our ventures have distinct identities, but
          share practical engineering, thoughtful operations, and a commitment to making something
          useful for real people.
        </p>
        <p>
          We experiment, learn from customers, and improve what we ship. That applies equally to a
          community platform, a commerce brand, or a new way to use AI.
        </p>
      </div>
    </div>
  </section>
  <section class="section pillars">
    <div class="container">
      <p class="eyebrow">The work spans three fields</p>
      <div class="pillar-grid">
        <article>
          <span>01</span>
          <h3>Commerce</h3>
          <p>Independent brands with real products, real customers, and a reason to exist.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Community</h3>
          <p>Tools and gathering places that help people share what they love.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Technology</h3>
          <p>Software and AI experiments grounded in everyday usefulness.</p>
        </article>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container founder-grid">
      <div>
        <p class="eyebrow">The founder</p>
        <h2 class="section-title">Meet Kevin Harder.</h2>
      </div>
      <div>
        <p>
          Kevin is a software engineer with more than 25 years of experience across startups and
          enterprise teams, from development to architecture and engineering leadership. He founded
          Harder Labs to bring his independent ventures together under one roof and keep building at
          the intersection of technology, commerce, and community.
        </p>
        <p>
          For his career story and personal work, visit{" "}
          <a
            class="inline-link"
            href="https://kevinharder.com"
            target="_blank"
            rel="noreferrer noopener"
          >
            KevinHarder.com
          </a>
          .
        </p>
        <div class="hero-actions">
          <GlowButton href="/contact">Get in touch</GlowButton>
          <GlowButton href="/projects" variant="ghost">
            Explore projects
          </GlowButton>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .about-intro,
  .founder-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
  }
  .about-intro .section-title {
    max-width: 17ch;
  }
  .about-intro p:not(.eyebrow),
  .founder-grid p:not(.eyebrow) {
    max-width: 65ch;
    margin-top: 1.5rem;
    font-size: 1.1rem;
  }
  .pillars {
    background: var(--paper);
  }
  .pillars .eyebrow {
    color: #5d6b56;
  }
  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
    margin-top: 3rem;
  }
  .pillar-grid article {
    border-top: 1px solid #9fac97;
    padding-top: 1rem;
  }
  .pillar-grid span {
    color: #5e773e;
    font:
      500 0.7rem var(--font-ibm-plex-mono),
      monospace;
  }
  .pillar-grid h3 {
    margin: 3rem 0 1rem;
    color: #17231b;
    font:
      500 1.6rem var(--font-sora),
      sans-serif;
    letter-spacing: -0.04em;
  }
  .pillar-grid p {
    color: #4b594d;
  }
  .founder-grid .section-title {
    margin-top: 1.2rem;
  }
  @media (max-width: 800px) {
    .about-intro,
    .founder-grid,
    .pillar-grid {
      grid-template-columns: 1fr;
    }
    .pillar-grid h3 {
      margin: 1.2rem 0 0.6rem;
    }
  }
</style>
