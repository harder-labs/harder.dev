---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact Harder Labs | Austin, Texas"
  description="Contact Harder Labs in Austin, Texas for partnerships, technical inquiries, or brand support."
>
  <section class="page-hero">
    <div class="container">
      <p class="muted">04 / Contact</p>
      <h1 class="hero-title">Let's start a conversation.</h1>
      <p class="hero-subtitle">
        Have a question, a partnership idea, or a note for one of our brands? Find the right inbox
        below.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p class="eyebrow">General inquiries</p>
      <a class="primary-email" href="mailto:kevin@harder.dev">
        kevin@harder.dev <span aria-hidden="true">↗</span>
      </a>
      <p class="contact-note">
        For partnerships, press, technical questions, and official notices.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Brand support</p>
          <h2 class="section-title">Talk to the right team.</h2>
        </div>
      </div>
      <div class="contact-grid">
        <a href="mailto:info@sharepuzzles.com">
          <span>01 / Community</span>
          <strong>SharePuzzles</strong>
          <span>info@sharepuzzles.com ↗</span>
        </a>
        <a href="mailto:info@hillcountrygear.com">
          <span>02 / Outdoors</span>
          <strong>Hill Country Gear</strong>
          <span>info@hillcountrygear.com ↗</span>
        </a>
        <a href="mailto:info@stellararcade.com">
          <span>03 / Collectibles</span>
          <strong>Stellar Arcade</strong>
          <span>info@stellararcade.com ↗</span>
        </a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container social-row">
      <div>
        <p class="eyebrow">Find us elsewhere</p>
        <p>
          Austin based, digital first. Please contact us by email before sending physical returns.
        </p>
      </div>
      <div>
        <a href="https://www.linkedin.com/in/KevinHarder" target="_blank" rel="noreferrer noopener">
          LinkedIn ↗
        </a>
        <a href="https://github.com/harder" target="_blank" rel="noreferrer noopener">
          GitHub ↗
        </a>
        <a href="https://x.com/kevinharder" target="_blank" rel="noreferrer noopener">
          X ↗
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .primary-email {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--accent-primary);
    padding: 1rem 0;
    max-width: 950px;
    color: var(--accent-primary);
    font:
      500 clamp(1.9rem, 5vw, 5rem)/1.2 var(--font-sora),
      sans-serif;
    letter-spacing: -0.055em;
    overflow-wrap: anywhere;
  }
  .primary-email:hover {
    color: var(--text-main);
  }
  .contact-note {
    margin-top: 1rem;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    border: 1px solid var(--border);
    background: var(--border);
  }
  .contact-grid a {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 225px;
    padding: 1.5rem;
    background: var(--surface-0);
  }
  .contact-grid a:hover {
    background: var(--surface-1);
  }
  .contact-grid span {
    color: var(--accent-primary);
    font:
      0.7rem var(--font-ibm-plex-mono),
      monospace;
  }
  .contact-grid strong {
    font:
      500 1.5rem var(--font-sora),
      sans-serif;
    letter-spacing: -0.04em;
  }
  .social-row {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }
  .social-row p:not(.eyebrow) {
    max-width: 55ch;
    margin-top: 1rem;
  }
  .social-row > div:last-child {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: start;
  }
  .social-row a {
    border-bottom: 1px solid var(--accent-primary);
    color: var(--accent-primary);
  }
  @media (max-width: 800px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .contact-grid a {
      min-height: 160px;
    }
    .social-row {
      display: block;
    }
    .social-row > div:last-child {
      margin-top: 2rem;
    }
  }
</style>
