---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LiveSignalsWidget from "@/components/islands/LiveSignalsWidget";
const workerBaseUrl = import.meta.env.PUBLIC_AI_WORKER_URL || "";
---

<BaseLayout
  title="AI & Engineering Signals | Harder Labs"
  description="Read curated AI and engineering release summaries, with practical notes on why each update matters."
>
  <section class="page-hero">
    <div class="container">
      <p class="muted">03 / Signals</p>
      <h1 class="hero-title">The useful stuff, distilled.</h1>
      <p class="hero-subtitle">
        A live reading list of engineering and AI releases, with short summaries and notes on why
        each one matters.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="signal-heading">
        <p class="eyebrow">Latest from trusted sources</p>
        <p>Updated from selected product, platform, and open source feeds.</p>
      </div>
      <LiveSignalsWidget client:visible maxItems={10} workerBaseUrl={workerBaseUrl} />
    </div>
  </section>
</BaseLayout>
<style>
  .signal-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .signal-heading p:last-child {
    font-size: 0.85rem;
  }
</style>
